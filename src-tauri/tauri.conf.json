{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KIVU SUBLIME APP",
  "version": "1.1.0",
  "identifier": "com.mutoni.quincaillerie-manager",
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "KIVU SUBLIME",
    "copyright": "Copyright © 2026 KIVU SUBLIME",
    "category": "Business",
    "shortDescription": "Hardware shop management for KIVU SUBLIME",
    "longDescription": "Offline inventory, sales, purchasing, customer, supplier, cash and reporting management.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "KIVU SUBLIME APP",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 640,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  }
}
